{
  // WXT 0.19 在 .wxt/tsconfig.json 输出三斜线引用 + SFC vite builder env,
  // 这是 vue-tsc 看到 browser / defineBackground / defineContentScript 等
  // 全局声明的入口。手写 tsconfig 不继承的话 vue-tsc 报 25+ TS2304
  // (e2e/options/popup/background 等全部 .vue/.ts 文件命中)。
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "jsx": "preserve",
    "noEmit": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["chrome", "wxt/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "env.d.ts",
    "shims-vue.d.ts",
    ".wxt/wxt.d.ts",
    ".wxt/types/**/*.d.ts",
    "entrypoints/**/*",
    "shared/**/*",
    "wxt.config.ts"
  ],
  "exclude": ["node_modules", ".output", "e2e", "playwright.config.ts", "vitest.config.ts", "shared/**/*.test.ts"]
}
