# docker compose 部署配置（复制为 .env 后按需修改）
#
#   cp .env.example-compose .env
#   docker compose up -d

# 宿主机映射端口（容器内固定 3000）
PORT=3000

# ⚠️ 部署在 nginx / Cloudflare 等反向代理之后必须置为 true：
# 否则所有请求按 socket 地址 127.0.0.1 计桶，共用一个限流桶互相挤掉。
# 直连（端口直接暴露给客户端）保持 false。
TRUST_PROXY=false

# 缓存 TTL（秒），默认 30 天
CACHE_TTL_SECONDS=2592000

# 限流：每窗口每真实 IP 的请求次数（lookup 宽松、commit 严格）
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_LOOKUP=120
RATE_LIMIT_COMMIT=30
